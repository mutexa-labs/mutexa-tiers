{
  "name": "@mutexa/tiers",
  "version": "0.1.0",
  "description": "Read a holder's $MUTEX balance on Robinhood Chain with viem and map it to a tier from a threshold table you supply.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mutexa-labs/mutexa-tiers.git"
  },
  "homepage": "https://github.com/mutexa-labs/mutexa-tiers#readme",
  "bugs": {
    "url": "https://github.com/mutexa-labs/mutexa-tiers/issues"
  },
  "keywords": [
    "erc20",
    "token-gating",
    "tiers",
    "viem",
    "robinhood-chain",
    "mutexa"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "test": "vitest run",
    "test:live": "LIVE=1 vitest run test/live.test.ts"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "prettier": "^3.9.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "viem": "^2.57.10",
    "vitest": "^3.2.7"
  }
}
